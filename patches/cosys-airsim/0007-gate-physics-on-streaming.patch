@@ -60,6 +63,21 @@
     std::unique_ptr<PhysicsEngineBase> createPhysicsEngine();
 
 private:
+    // SIM-32: physics does not start until the ground exists.
+    //
+    // On a World Partition world the terrain streams in AROUND the vehicle, and the vehicle
+    // begins falling on the very first physics step -- so it can pass through where the ground
+    // is about to be. Everything before this either raced that or reacted to it.
+    //
+    // These hold the gate: the updator is not started in initializeForPlay(), and Tick() starts
+    // it once streaming has settled, or once the deadline expires.
+    bool physics_started_ = false;
+    float physics_gate_waited_s_ = 0.0f;
+
+    // A GATE WITH NO ESCAPE IS A HANG, which is a worse failure than the race it replaces. If
+    // streaming never reports completion the simulator must start anyway and say so, loudly.
+    static constexpr float kPhysicsGateTimeoutS = 300.0f;
+
     std::unique_ptr<msr::airlib::PhysicsWorld> physics_world_;
     PhysicsEngineBase* physics_engine_;
 
