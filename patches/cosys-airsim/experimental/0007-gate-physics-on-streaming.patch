+bool ASimModeWorldBase::isStreamingSettled() const
+{
+    UWorld* world = GetWorld();
+    if (!world)
+        return true;
+
+    // A world with no partition never streams, so there is nothing to wait for. This is what
+    // keeps Blocks and every other non-World-Partition map completely unaffected.
+    UWorldPartitionSubsystem* wp = world->GetSubsystem<UWorldPartitionSubsystem>();
+    if (!wp)
+        return true;
+
+    // ASK ABOUT THE CELLS UNDER THE VEHICLE, not about every streaming level in the world.
+    //
+    // The first cut passed nullptr, which means "all streaming levels". MEASURED on CitySample:
+    // that never went true -- a world with continuously streaming traffic and crowds may simply
+    // never be globally settled -- so every bring-up waited out the timeout instead of releasing
+    // when the ground was ready. Correct, and uselessly slow.
+    //
+    // The query-source form asks the question that actually matters. bUseGridLoadingRange keeps
+    // the radius consistent with whatever the world's own streaming grid uses, rather than
+    // inventing a distance here; EWorldPartitionRuntimeCellState::Activated is the state a cell
+    // must reach before its collision exists, which is the whole point.
+    TArray<FWorldPartitionStreamingQuerySource> sources;
+    for (auto& api : getApiProvider()->getVehicleSimApis()) {
+        PawnSimApi* pawn_api = static_cast<PawnSimApi*>(api);
+        if (!pawn_api)
+            continue;
+        FWorldPartitionStreamingQuerySource source;
+        source.Location = pawn_api->getUUPosition();
+        source.bUseGridLoadingRange = true;
+        source.bSpatialQuery = true;
+        sources.Add(source);
+    }
+
+    // No vehicles yet means nothing to protect, so do not hold physics on their behalf.
+    if (sources.Num() == 0)
+        return true;
+
+    return wp->IsStreamingCompleted(EWorldPartitionRuntimeCellState::Activated, sources,
+                                    /*bExactState=*/false);
+}
+
 void ASimModeWorldBase::Tick(float DeltaSeconds)
 {
+    // Asked ONCE per tick and shared with the gate below -- the query is not free, and two callers
+    // could otherwise disagree within a single frame.
+    const bool probing = gate_probe_elapsed_s_ < kGateProbeWindowS;
+    const bool settled_now = (probing || !physics_started_) ? isStreamingSettled() : false;
+
+    if (probing) {
+        gate_probe_elapsed_s_ += DeltaSeconds;
+        if (settled_now != gate_probe_last_) {
+            gate_probe_last_ = settled_now;
+            UE_LOG(LogTemp, Display, TEXT("SIM-32 probe: streaming settled -> %s at %.3f s"),
+                   settled_now ? TEXT("TRUE") : TEXT("FALSE"), gate_probe_elapsed_s_);
+        }
+    }
+
+    if (!physics_started_) {
+        physics_gate_waited_s_ += DeltaSeconds;
+        const bool settled = settled_now;
+        const bool timed_out = physics_gate_waited_s_ >= kPhysicsGateTimeoutS;
+
+        if (settled || timed_out) {
+            physics_started_ = true;
+            startAsyncUpdator();
+            if (timed_out && !settled) {
+                // LOUD, because this is the case where the vehicle may still fall: the gate gave
+                // up rather than the world becoming ready.
+                UAirBlueprintLib::LogMessageString(
+                    "SIM-32: world partition streaming did NOT settle; starting physics anyway "
+                    "after seconds: ",
+                    std::to_string(physics_gate_waited_s_), LogDebugLevel::Failure);
+                // LogMessageString renders to the on-screen Slate overlay ONLY. It never reaches
+                // stdout, so on a headless run the verdict is invisible -- it had to be read off a
+                // screenshot once already. UE_LOG is what docker logs can see.
+                UE_LOG(LogTemp, Error,
+                       TEXT("SIM-32: streaming did NOT settle; physics started anyway after %.3f s"),
+                       physics_gate_waited_s_);
+            }
+            else {
+                UAirBlueprintLib::LogMessageString(
+                    "SIM-32: streaming settled; physics started after seconds: ",
+                    std::to_string(physics_gate_waited_s_), LogDebugLevel::Informational);
+                UE_LOG(LogTemp, Display,
+                       TEXT("SIM-32: streaming settled; physics started after %.3f s"),
+                       physics_gate_waited_s_);
+            }
+        }
+        else {
+            // NOT BLOCKING. Returning here keeps the game thread free -- which matters because
+            // that is the thread doing the streaming we are waiting for. Blocking inside this
+            // function would prevent the very work that ends the wait.
+            Super::Tick(DeltaSeconds);
+            return;
+        }
+    }
+
     { //keep this lock as short as possible
         physics_world_->lock();
 
