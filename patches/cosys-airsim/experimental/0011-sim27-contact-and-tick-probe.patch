         // question about which call site fires.
-        enum Sim27Gate { kGateA = 0, kGateB, kGateC, kGateD, kGateE, kSim27GateCount };
+        enum Sim27Gate { kGateA = 0, kGateB, kGateC, kGateD, kGateE, kGateG, kSim27GateCount };
         static void sim27Log(Sim27Gate gate, const std::string& msg, double seconds = 0.25)
         {
             static uint64_t last_ns[kSim27GateCount] = { 0 };
