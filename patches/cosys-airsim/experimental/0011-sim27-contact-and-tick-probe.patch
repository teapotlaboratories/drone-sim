+            // SIM-27: gate G -- EVERY tick, grounded or not. Gate D only logged while the body
+            // was grounded, so a descent through the surface produced silence, and silence was
+            // read (wrongly, twice) as evidence. This line is unconditional: it says where the
+            // body is, how fast, and whether the engine considers it on the ground, throughout.
+            sim27Log(kGateG, Utils::stringf(
+                "gate=G-TICK grounded=%d z=%.3f vz=%.3f collided=%d",
+                body.isGrounded() ? 1 : 0, current.pose.position.z(), current.twist.linear.z(),
+                body.getCollisionInfo().has_collided ? 1 : 0));
             Kinematics::State next;
             Wrench next_wrench;
 
@@ -320,7 +328,7 @@
         // that measured this produced 386 lines and not one gate=C, from a landing that
