@@ -6,6 +6,10 @@
 
 AFlyingPawn::AFlyingPawn()
 {
+    // Harmless in non-World-Partition levels (Blocks, CityPark): the component simply has no
+    // partition to drive. In a World Partition level it is what makes the world exist at all.
+    streaming_source_ = CreateDefaultSubobject<UWorldPartitionStreamingSourceComponent>(TEXT("WorldPartitionStreamingSource"));
+
     init_id_ = pawn_events_.getActuatorSignal().connect_member(this, &AFlyingPawn::initializeRotors);
     pawn_events_.getActuatorSignal().connect_member(this, &AFlyingPawn::setRotorSpeed);
 }
@@ -13,6 +17,14 @@
 void AFlyingPawn::BeginPlay()
 {
     Super::BeginPlay();
+
+    // Enable explicitly rather than trusting the default: the component is constructed with
+    // bStreamingSourceEnabled from its own CDO, and a Blueprint subclass (BP_FlyingPawn is one)
+    // can carry a stale archetype value. Enabling here makes the behaviour independent of that.
+    if (streaming_source_)
+    {
+        streaming_source_->EnableStreamingSource();
+    }
 }
 
 void AFlyingPawn::initializeForBeginPlay()
