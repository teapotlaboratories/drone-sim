  # ego-planner-swarm:
  #   type: git
  #   url: https://github.com/ZJU-FAST-Lab/ego-planner-swarm.git
  #   version: TODO-verify   # ROS 2 branch, drone_id=0; port ships a code-map doc

  # --- Phase 4 / Lane C: UE5.5 + Cosys-AirSim ---------------------------------
