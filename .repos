# vcstool manifest for third-party trees — preferred over git submodules
# (.ai/AGENTS.md:316). Checked out into vendor/, which is git-ignored.
#
#   vcs import vendor < .repos
#   vcs status vendor
#
# Versions here MUST agree with versions.lock. versions.lock is the authority and
# carries the reasoning; this file is the mechanism. When a `sha: TODO-verify` in
# versions.lock is resolved, pin the SHA here too — a tag can move, a SHA cannot.
#
# Phase-gated on purpose: only the Phase 0 (Lane A) set is active. The Lane B and Lane C
# trees are left commented out so `vcs import` does not pull tens of GB of Isaac/UE5
# dependencies before those lanes are actually being built. Uncomment per phase.

repositories:

  # --- Phase 0 / Lane A: PX4 v1.16.x + uXRCE-DDS + ROS 2 Jazzy -----------------
  PX4-Autopilot-v1.16:
    type: git
    url: https://github.com/PX4/PX4-Autopilot.git
    version: v1.16.0
    # Recursive submodules required: git submodule update --init --recursive
    # Also serves REAL hardware (Pixhawk 6C).

  Micro-XRCE-DDS-Agent:
    type: git
    url: https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
    version: 73622810d984349b80bbac0ef55fc0b694d62222   # v2.4.3
    # CORRECTED 2026-07-31: this said v2.4.2, which versions.lock records as
    # GENUINELY UNBUILDABLE — upstream deleted the Fast-DDS branch its superbuild pins
    # (`fatal: invalid reference: 2.12.x`). `vcs import` from the old value reconstructed
    # a broken tree, which is precisely the failure this project has a rule against.
    # Build with -DUAGENT_USE_SYSTEM_FASTDDS=ON.

  px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: release/1.16
    # MUST stay branch-matched to PX4-Autopilot-v1.16. A mismatch is silent.

  px4_ros_com:
    type: git
    url: https://github.com/PX4/px4_ros_com.git
    version: 86e9aeb20e55a4673fa8a9f1c29ea06a6c5ad1af   # release/1.16
    # CORRECTED 2026-07-31: this said `main`, mirroring the development plan's snippet,
    # which branch-matches px4_msgs but NOT px4_ros_com. versions.lock resolved that
    # asymmetry — upstream does publish release/1.16 and both are branch-matched here.

  # --- Phase 3 / Lane B: Isaac Sim 5.1 + Pegasus + PX4 v1.14.3 -----------------
  # Blocked pending the Isaac-vs-driver-610.43.03 verification (versions.lock).
  #
  # PX4-Autopilot-v1.14.3:
  #   type: git
  #   url: https://github.com/PX4/PX4-Autopilot.git
  #   version: v1.14.3
  #   # A SECOND, separate checkout. MAVLink SITL (TCP 4560), not uXRCE-DDS.
  #
  # PegasusSimulator:
  #   type: git
  #   url: https://github.com/PegasusSimulator/PegasusSimulator.git
  #   version: v5.1.0   # TODO-verify exact tag name upstream
  #
  # IsaacSim-ros_workspaces:
  #   type: git
  #   url: https://github.com/isaac-sim/IsaacSim-ros_workspaces.git
  #   version: TODO-verify   # build jazzy_ws against Python 3.11

  # --- Phase 2 / planning + perception ----------------------------------------
  #
  # ego-planner-swarm:
  #   type: git
  #   url: https://github.com/ZJU-FAST-Lab/ego-planner-swarm.git
  #   version: TODO-verify   # ROS 2 branch, drone_id=0; port ships a code-map doc

  # --- Phase 2+ / Lane C: UE5.8 + Cosys-AirSim — THE PRIMARY STACK ------------
  # ACTIVATED 2026-07-31. Lane C is no longer a Phase 4 concern: it is the primary
  # simulator from Phase 2 on. ~1.3 GB checked out — large, but not the tens of GB the
  # header warns about (that is the UE5 engine IMAGE, 24 GB, which is Docker's problem
  # and not vcstool's). Engine version is 5.8, not 5.5: UE5.5 and ROS 2 Jazzy cannot be
  # had from one upstream tag. See versions.lock lane_c.cosys_airsim.

  Cosys-AirSim:
    type: git
    url: https://github.com/Cosys-Lab/Cosys-AirSim.git
    version: a552dd6cd517b8d5d26629ad88004356c3007326   # tag 5.8-v3.4.1, UE5.8
    # A SHA, never a branch: there is no `5.5` branch upstream at all, and `main` has
    # already migrated 5.5 -> 5.6dev -> 5.7pdev -> 5.8. Verified on checkout 2026-07-31.
